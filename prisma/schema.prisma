generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  role         String       @default("user")
  passwordHash String?
  emailVerified DateTime?
  image        String?
  templates    Template[]   @relation("TemplateAuthor")
  reports      Report[]     @relation("ReportAuthor")
  apiSessions  ApiSession[]
  accounts     Account[]
  sessions     Session[]
  auditLogs    AuditLog[]   @relation("AuditActor")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// NextAuth.js用のモデル
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token       String   @unique
  expires     DateTime

  @@unique([identifier, token])
}

// 既存のAPI用セッション（tokenベース）
model ApiSession {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Template {
  id              String            @id @default(cuid())
  name            String
  description     String?
  createdBy       User              @relation("TemplateAuthor", fields: [createdById], references: [id])
  createdById     String
  currentVersion  TemplateVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  currentVersionId String?          @unique
  versions        TemplateVersion[]
  reports         Report[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([createdById])
}

model TemplateVersion {
  id                String          @id @default(cuid())
  template          Template        @relation(fields: [templateId], references: [id])
  templateId        String
  currentTemplate   Template?       @relation("CurrentVersion")
  version           Int
  status            String          @default("published") // draft | published | archived
  content           Json            // JSONベースのレイアウト/本文
  fields            TemplateField[]
  reports           Report[]
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@unique([templateId, version])
  @@index([templateId])
}

model TemplateField {
  id                 String          @id @default(cuid())
  templateVersion    TemplateVersion @relation(fields: [templateVersionId], references: [id])
  templateVersionId  String
  key                String
  label              String
  inputType          String // text | textarea | number | date | select | checkbox | signature など
  required           Boolean @default(false)
  order              Int
  config             Json?  // 選択肢や単位など拡張設定
  createdAt          DateTime @default(now())

  @@unique([templateVersionId, key])
  @@index([templateVersionId, order])
}

model Report {
  id                String           @id @default(cuid())
  template          Template         @relation(fields: [templateId], references: [id])
  templateId        String
  templateVersion   TemplateVersion  @relation(fields: [templateVersionId], references: [id])
  templateVersionId String
  title             String
  status            String           @default("draft") // draft | submitted | approved | archived
  content           Json?
  fieldValues       ReportFieldValue[]
  images            ReportImage[]
  author            User             @relation("ReportAuthor", fields: [authorId], references: [id])
  authorId          String
  submittedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([templateId])
  @@index([templateVersionId])
  @@index([authorId])
  @@index([status])
}

model ReportFieldValue {
  id          String  @id @default(cuid())
  report      Report  @relation(fields: [reportId], references: [id])
  reportId    String
  fieldKey    String
  value       Json
  displayOrder Int?
  createdAt   DateTime @default(now())

  @@unique([reportId, fieldKey])
  @@index([reportId])
}

model ReportImage {
  id        String  @id @default(cuid())
  report    Report  @relation(fields: [reportId], references: [id])
  reportId  String
  s3Key     String
  s3Url     String
  caption   String?
  order     Int
  createdAt DateTime @default(now())

  @@index([reportId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorId    String?
  action     String   // e.g. TEMPLATE_CREATED, REPORT_SUBMITTED
  targetType String   // e.g. template | report | user
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}

